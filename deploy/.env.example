# Shared Trips private env file TEMPLATE. Placeholders only.
# Copy outside the checkout (see deploy/README.md), restrict to mode 0600,
# then edit with a private editor. Never commit, paste, or print the filled-in
# copy, and never run plain `docker compose config` (it prints these values).

# Owner-only administrator bearer secret (32-512 ASCII characters). It is the
# master credential. Keep it owner-only; use scoped manager access for MCP.
SHARED_TRIP_ADMIN_TOKEN=<REPLACE-with-a-random-secret-of-32-to-512-characters>

# Public HTTPS origin (no path) and the same hostname for Caddy.
SHARED_TRIP_ORIGIN=https://trips.example.org
SHARED_TRIP_DOMAIN=trips.example.org

# Optional existing approved content manager eligible for OAuth consent.
# Empty disables legacy OAuth unless multiuser mode below is explicitly enabled.
# Neither setting creates, approves or promotes an account.
SHARED_TRIP_OAUTH_USERNAME=
# Optional: 1 lets existing approved accounts consent independently. Members get
# read-only MCP; content managers may consent to editing on member trips only.
SHARED_TRIP_OAUTH_MULTIUSER=0

# Optional public place/photo searches. Review provider policies and outbound
# networking before enabling; supply your own identifying app/version + contact.
SHARED_TRIP_LOOKUPS_ENABLED=0
SHARED_TRIP_LOOKUP_USER_AGENT=
SHARED_TRIP_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Optional Google Places UI Kit (browser-side standard components only).
# Off by default. Enabling it is an owner decision after reviewing Google's
# terms and pricing; it needs both the Maps JavaScript API and Places UI Kit
# enabled in the owner's project, and the key must be the owner's own BROWSER
# key restricted to this site's origin and to those two APIs. Leave both
# empty/0 unless you have done that.
SHARED_TRIP_GOOGLE_PLACES_UI_KIT=0
SHARED_TRIP_GOOGLE_MAPS_BROWSER_KEY=
# Monthly Google allowance for this app (no default; both or neither). The
# share of the monthly free Places UI Kit Query (Essentials) usage that YOU
# allocated to this app (at most 10000, the verified free cap; never an
# entitlement to paid usage), and a safety margin of at least 1 kept unused.
# At most allowance - headroom reservations per Pacific-time month; for
# example 10000 - 1000 = 9000, only if nothing else on the billing account
# uses that SKU. Empty or out of bounds = no Google work at all. Also create
# the ledger once with server/cli/google-allowance.mjs init; clock faults are
# cleared only with its reconcile-clock (see references/google-places-ui-kit.md).
# Not a provider-enforced cap and no promise of zero charges.
SHARED_TRIP_GOOGLE_MONTHLY_ALLOWANCE=
SHARED_TRIP_GOOGLE_ALLOWANCE_HEADROOM=

# Private absolute host paths outside the checkout and any public web root.
# Data and backups must be owned by UID 1000 and live on a local filesystem.
SHARED_TRIP_DATA_PATH=/PRIVATE/shared-trips/data
SHARED_TRIP_BACKUP_PATH=/PRIVATE/shared-trips/backups
CADDY_DATA_PATH=/PRIVATE/shared-trips/caddy-data
CADDY_CONFIG_PATH=/PRIVATE/shared-trips/caddy-config

# Change the app tag for every upgrade so the previous image stays available
# for rollback. Pin Caddy to a reviewed tag or digest.
SHARED_TRIP_IMAGE_TAG=local
CADDY_IMAGE=caddy:2
