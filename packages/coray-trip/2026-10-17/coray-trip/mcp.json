{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "coray-trip": {
      "type": "streamable-http",
      "url": "https://trip.coray.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["trips:manage"]
          }
        }
      }
    }
  }
}
